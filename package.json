{
  "name": "@hibira-io/inbox",
  "version": "0.1.0",
  "description": "Drop-in notification inbox on Hibira realtime: bell and feed components for React, Vue and React Native, read/unread and archive, live updates and push to offline users",
  "keywords": [
    "notifications",
    "notification-inbox",
    "in-app-notifications",
    "notification-feed",
    "bell",
    "inbox",
    "react",
    "vue",
    "react-native",
    "pusher",
    "realtime",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/inbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/inbox.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./react-native": {
      "types": "./react-native.d.ts",
      "default": "./react-native.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "react.js",
    "react.d.ts",
    "vue.js",
    "vue.d.ts",
    "react-native.js",
    "react-native.d.ts",
    "view.js",
    "locales.js",
    "types.d.ts",
    "styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --import ./test/stubs/register.mjs --test test/*.test.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.72",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  }
}
